library('dplyr')
library('ggplot2')
avg_price_monthly <- read.csv(file.choose(),header=T)
avg_price_monthly |>
glimpse()
summary(avg_price_monthly)
avg_price_mo <- avg_price_monthly |>
mutate(category = factor(category,c(
"Meat, broad category",
"Pork and deli",
"Beef",
"Drinks",
"Dairy and fats",
"Energy",
"Fruit",
"Vegetables",
"Bakery and grains",
"Poultry",
"Eggs",
"Pantry and snacks"
))

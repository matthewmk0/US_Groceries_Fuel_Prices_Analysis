#                              "2024",
#                              "2025",
#                              "2026")),
# month = factor(month,seq(1,12))
)
avg_price_mo <- avg_price_mo[,-c(1,8)]
nrow(avg_price_mo)
ncol(avg_price_mo)
summary(avg_price_mo)
